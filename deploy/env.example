# /etc/obsidian-mcp/env — production environment for obsidian-mcp on the VM.
#
# Installed by deploy/provision.sh ONLY if the file does not exist yet
# (root:root 0600); PUBLIC_BASE_URL is rewritten from $DOMAIN. Re-running
# provision never overwrites it. Edit with:  sudoedit /etc/obsidian-mcp/env
# then:  sudo systemctl restart obsidian-mcp
#
# Format: systemd EnvironmentFile — KEY=value, no `export`, no shell expansion,
# quotes only if the value contains spaces. provision.sh refuses to start the
# service while any value is still FILL_ME_IN.

# ----------------------------------------------------------------- transport --
# Streamable HTTP, only on loopback: Caddy terminates TLS and proxies to it.
TRANSPORT=http
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------- vault ----
# Single-vault mode. Kept in sync with Obsidian Sync by ob (Obsidian Headless).
VAULT_PATH=/var/lib/obsidian/vault
# Multi-vault mode instead (path to a vaults.json, see docs/multi-vault.md).
# When set, the VAULT_PATH/*_PATHS settings below come from that file.
# VAULTS_CONFIG=

# ------------------------------------------------------------ auth (GitHub) ---
# Public base URL (no trailing slash). OAuth callback = <this>/auth/callback,
# claude.ai connector URL = <this>/mcp.
PUBLIC_BASE_URL=https://obsidian.mcp.htarrega.me
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:               https://obsidian.mcp.htarrega.me
#   Authorization callback URL: https://obsidian.mcp.htarrega.me/auth/callback
OAUTH_GITHUB_CLIENT_ID=FILL_ME_IN
OAUTH_GITHUB_CLIENT_SECRET=FILL_ME_IN
# Comma-separated GitHub logins allowed to authenticate (case-insensitive).
# There is no "allow everyone" fallback.
OAUTH_GITHUB_ALLOWED_LOGINS=htarrega

# [new security settings — being added in parallel; defaults shown]
# GitHub scopes requested at login. read:user is enough to learn the login.
OAUTH_GITHUB_SCOPES=read:user
# Client ID Metadata Documents (URL-as-client_id). Off: only dynamically
# registered clients whose redirect URIs match the allowlist below.
OAUTH_ENABLE_CIMD=false
# Redirect URIs MCP clients may register (comma-separated, `*` = any port).
# claude.ai web/mobile connector + local clients (Claude Code / Desktop).
OAUTH_ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:*,http://127.0.0.1:*
# Lifetime of issued MCP access tokens (30 days).
OAUTH_ACCESS_TOKEN_EXPIRY_SECONDS=2592000
# Lifetime of issued MCP refresh tokens (90 days; then the client logs in again).
OAUTH_REFRESH_TOKEN_EXPIRY_SECONDS=7776000

# Optional static bearer key (Authorization: Bearer <key>) for non-OAuth
# clients such as curl or scripts. Empty = OAuth only (recommended here).
# Generate with: openssl rand -hex 32
API_KEY=

# FastMCP data dir: persisted OAuth client registrations/tokens (so restarts
# don't force re-login). Also the parent of the default LOCK_PATH. chmod 700.
FASTMCP_HOME=/var/lib/obsidian/mcp-data
FASTMCP_CHECK_FOR_UPDATES=off
FASTMCP_SHOW_SERVER_BANNER=false

# ----------------------------------------------------------- write policy -----
# Writing is wanted on this deployment.
READ_ONLY=false
# Write allowlist, comma-separated, rooted at the vault. EMPTY = whole vault
# (minus DENY_WRITE_PATHS). A trailing slash means "this folder and everything
# below it"; without a slash the rule matches that exact file only. Example to
# confine the AI to an inbox:  WRITE_PATHS=Inbox/
WRITE_PATHS=
# Never writable, even if under WRITE_PATHS. .obsidian/ protects Obsidian's
# config and ob's sync lock (.obsidian/.sync.lock); .trash/ and
# _AI_INSTRUCTIONS.md are the upstream defaults, kept on purpose (setting this
# variable replaces the default list, it does not extend it). "(000) System/"
# protects the whole system folder, including CONVENTIONS_PATH below, so the
# AI cannot rewrite its own rules.
DENY_WRITE_PATHS=".obsidian/,.trash/,_AI_INSTRUCTIONS.md,(000) System/"
# Optional read allowlist (empty = whole vault minus DENY_READ_PATHS).
READ_PATHS=
# Never readable (security boundary, unlike EXCLUDE_PATHS).
DENY_READ_PATHS=.obsidian/,.trash/
# Hidden from listing/search/indexing only (not access control).
EXCLUDE_PATHS=private/,.obsidian/,.trash/
# Overwriting an existing note requires the revision from a prior read
# (optimistic concurrency) — avoids clobbering edits that arrived via Sync.
REQUIRE_WRITE_PRECONDITIONS=true
# Max attachment size accepted by write tools (bytes, default 25 MiB). Caddy's
# request_body limit (50MB) leaves room for base64 overhead.
MAX_ATTACHMENT_BYTES=26214400

# ------------------------------------------------------------ vault layout ---
# Where the Mentat vault keeps things (docs/configuration.md#vault-layout).
# Paths are vault-relative; spaces/parentheses/accents are fine (quote the
# value). Unset = upstream defaults (Templates/, Journal/..., Journal+Templates
# orphan excludes, _AI_INSTRUCTIONS.md at the root).
# Conventions file read by get_vault_conventions/lint_schema. While it does not
# exist the tool returns an auto-generated summary of the vault instead.
CONVENTIONS_PATH="(000) System/_AI_INSTRUCTIONS.md"
# Folders get_orphans skips (comma-separated; entries with "/" are rooted
# prefixes, single names match that folder at any depth).
ORPHAN_EXCLUDES="(000) System,(100) Attachments,(400) Personal"
# Root/index note, never reported as an orphan.
ENTRY_NOTE="(500) Root/Mentat.md"
# This vault uses no templates and no periodic notes, so these stay unset:
# list_templates returns [] with a hint, get_periodic_note returns
# exists=false + suggested_path. Examples if that changes:
# TEMPLATES_DIR="(000) System/Templates"
# PERIODIC_DAILY_PATH="(400) Personal/Journal/{{date:YYYY-MM-DD}}.md"
# PERIODIC_WEEKLY_PATH="(400) Personal/Journal/Weekly/{{date:GGGG-[W]WW}}.md"
# PERIODIC_MONTHLY_PATH="(400) Personal/Journal/Monthly/{{date:YYYY-MM}}.md"

# --------------------------------------------- high-impact tools (opt-in) -----
# Disabled tools are not registered at all (absent from the client tool list).
# delete_note & co. Off: deletions propagate to every device through Sync.
ENABLE_DELETE=false
# With ENABLE_DELETE=true, also allow permanent (non-.trash) deletion.
ALLOW_PERMANENT_DELETE=false
# Move/rename single notes (rewrites links). Off: easy to scramble the vault.
ENABLE_MOVE=false
# Rename whole folders. Off: large, hard-to-review changes.
ENABLE_FOLDER_RENAME=false
# Search-and-replace across many notes. Off: one bad regex touches everything.
ENABLE_BULK_REPLACE=false

# Optional plugin-format tool groups.
ENABLE_CANVAS=false
ENABLE_EXCALIDRAW=false
ENABLE_KANBAN=false
ENABLE_BASES=false

# ------------------------------------------------- exposed tool surface -------
# Applied after every registration above (ENABLE_* groups and ob tools): only
# the tools named here are advertised and callable; everything else stays
# registered internally but hidden. Unknown names only log a warning.
# This list mirrors the Obsidian CLI skill the vault is normally driven with:
#   read / search / outline / files / recents   -> read_note, search_notes,
#       query_notes, resolve_alias, get_outline, list_folder, get_recent_notes
#   create / append / prepend / edit             -> write_note, append_to_note,
#       prepend_to_note, patch_note_text, create_folder
#   tasks / task done                            -> get_tasks, set_task_status
#   backlinks / links / orphans / unresolved     -> get_backlinks,
#       get_outgoing_links, get_orphans, get_broken_links
#   vault summary / conventions                  -> get_vault_stats,
#       get_vault_conventions
#   attachments (read only)                      -> list_attachments,
#       read_attachment
#   sync health                                  -> sync_status
# Hidden on purpose:
#   - patch_frontmatter, manage_tags, list_all_tags, lint_schema: this vault
#     uses no frontmatter and no tags.
#   - get_periodic_note, list_templates, create_from_template: no daily notes
#     and no templates here.
#   - patch_note: patch_note_text and append_to_note(section=...) cover the
#     same edits with one clearer verb each.
#   - list_vaults: single vault.
#   - add_attachment, create_attachment_token: attachments are added from
#     Obsidian, not through the AI.
#   - find_similar_notes, get_link_graph, list_notes, list_files: overlap with
#     search_notes, get_backlinks/get_outgoing_links and list_folder.
#   - get_audit_log: an operator tool; the log stays on disk regardless.
#   - sync_logs, ob_info, list_remote_vaults, sync_restart: ob operations
#     (sync_restart stays registered via ENABLE_OB_OPS for a later re-enable;
#     the sync supervisor runs whatever is exposed).
TOOLS_ALLOWLIST=read_note_tool,search_notes_tool,query_notes_tool,resolve_alias_tool,get_outline_tool,list_folder_tool,get_recent_notes_tool,write_note_tool,append_to_note_tool,prepend_to_note_tool,patch_note_text_tool,create_folder_tool,get_tasks_tool,set_task_status_tool,get_backlinks_tool,get_outgoing_links_tool,get_orphans_tool,get_broken_links_tool,get_vault_stats_tool,get_vault_conventions_tool,list_attachments_tool,read_attachment_tool,sync_status
# Removed after the allowlist (comma-separated tool names). Empty = none.
TOOLS_DENYLIST=
# The generic MCP prompts (weekly_review, daily_note) assume a Journal/ with
# daily notes, and the vault:// resources duplicate read tools: both off.
ENABLE_PROMPTS=false
ENABLE_RESOURCES=false

# ------------------------------------------------ Obsidian Headless (ob) ------
# The server supervises `ob sync --continuous` as a child process (there is no
# separate systemd unit for ob).
# Also enables the always-on read-only tools: sync_status, sync_logs, ob_info,
# list_remote_vaults.
ENABLE_OB=true
# Operational tier: sync_restart (restarts the supervised ob child).
ENABLE_OB_OPS=true
# Admin tier: sync_set_excluded_folders / sync_set_file_types / sync_set_configs /
# sync_set_conflict_strategy (persistent sync-config changes). Ignored when
# READ_ONLY=true. Login/logout/setup/unlink are never exposed. Keep off.
ENABLE_OB_ADMIN=false
# Binary and runtime knobs (see README "ob CLI wrapper").
# NodeSource's nodejs uses npm prefix /usr, so `npm install -g` puts the ob
# shim at /usr/bin/ob (provision.sh verifies this and warns if it differs).
OB_BIN=/usr/bin/ob
# Sync log lines kept in memory for the ops tools.
OB_LOG_LINES=1000
# Timeout for one-shot ob commands (seconds).
OB_COMMAND_TIMEOUT=60
# Upper bound of the exponential restart backoff for `ob sync` (seconds).
OB_RESTART_BACKOFF_MAX=300
# sync_restart is refused if the child was (re)started less than this many
# seconds ago (0 disables the cooldown).
OB_RESTART_COOLDOWN=60

# --------------------------------------------- hardening (new, defaults) ------
# [new security settings — being added in parallel; defaults shown]
# Return generic errors to clients instead of internal exception details.
MASK_ERROR_DETAILS=true
# Max length of user-supplied regexes, and wall-clock limit per regex search.
REGEX_MAX_LENGTH=500
REGEX_TIMEOUT_SECONDS=2
# Largest {n}/{n,m} repetition count accepted in a user regex (compile-time
# memory guard; nested counted repetitions are limited too).
REGEX_MAX_REPEAT=100

# ------------------------------------------------------ indexing / storage ----
# Debounce for filesystem events (absorbs sync write storms), milliseconds.
WATCHER_DEBOUNCE_MS=100
# Full reconciliation of the index every N seconds (repairs missed events).
INDEX_RECONCILE_INTERVAL=900
# auto = inotify via watchdog, poll = force polling.
WATCH_MODE=auto
# Defaults derive from FASTMCP_HOME: <FASTMCP_HOME>/locks and
# <LOCK_PATH>/audit.jsonl. Both MUST be outside the vault.
# LOCK_PATH=/var/lib/obsidian/mcp-data/locks
# AUDIT_LOG_PATH=/var/lib/obsidian/mcp-data/locks/audit.jsonl
